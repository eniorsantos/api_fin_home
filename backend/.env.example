DATABASE_URL=postgresql://finance:finance@localhost:5433/finance
# Obtenha em https://brapi.dev/dashboard. NUNCA commite o valor real.
BRAPI_TOKEN=
PORT=3333
# Origem permitida no CORS (padrão: http://localhost:5173)
WEB_ORIGIN=http://localhost:5173
# Agendador de sync (desligado por padrão; SYNC_ENABLED=1 para ligar)
SYNC_ENABLED=0
SYNC_INTERVAL_MIN=60
SYNC_HISTORY_RANGE=1mo
# Cache de respostas da brapi (memória, por instância do cliente): 1 para ligar, 0 para desligar
BRAPI_CACHE=1
# JWT secret para assinar tokens (gere um valor aleatório forte em produção)
JWT_SECRET=dev-secret-change-in-production
# Redis URL para cache e filas (opcional; se não configurado, Redis desabilitado)
REDIS_URL=redis://localhost:6379
# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000